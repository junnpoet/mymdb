<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyMdb.app.ViewModels"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="820"
             Header="MyMdb"
             x:DataType="vm:HomeViewModel"
             x:Class="MyMdb.app.Views.HomeView">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="12,8,12,12" RowSpacing="8">
        <!-- Search bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText}"
                     PlaceholderText="Search title, director, actor..."
                     KeyDown="SearchBox_KeyDown"
                     ClearSelectionOnLostFocus="False" />
            <Button Grid.Column="1"
                    Content="Search"
                    Command="{Binding SearchCommand}" />
        </Grid>

        <!-- Quick filters -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="All"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="All" />
                <Button Content="Movies"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Movies" />
                <Button Content="TV Series"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Series" />
                <Button Content="Watched"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Watched" />
                <Button Content="Unwatched"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Unwatched" />
            </StackPanel>
        </ScrollViewer>

        <!-- Status / Error -->
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Opacity="0.7" />
            <TextBlock Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Virtualized catalog list -->
        <ListBox Grid.Row="3"
                 Name="CatalogList"
                 ItemsSource="{Binding FilteredEntries}"
                 SelectionChanged="CatalogList_SelectionChanged"
                 ContainerPrepared="CatalogList_ContainerPrepared"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MediaItemViewModel">
                    <Grid ColumnDefinitions="56,*" ColumnSpacing="12" Margin="0,4">
                        <Border Grid.Column="0"
                                Width="56"
                                Height="84"
                                CornerRadius="6"
                                ClipToBounds="True"
                                Background="#22808080">
                            <Image Source="{Binding Poster}"
                                   Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding MetaLine}"
                                       FontSize="12"
                                       Opacity="0.75" />
                            <TextBlock Text="{Binding GenresLine}"
                                       FontSize="12"
                                       Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                <TextBlock Text="{Binding RatingText}"
                                           IsVisible="{Binding HasRating}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#E0A800" />
                                <TextBlock Text="TV"
                                           IsVisible="{Binding IsTvSeries}"
                                           FontSize="11"
                                           Opacity="0.75" />
                                <TextBlock Text="Watched"
                                           IsVisible="{Binding IsWatched}"
                                           FontSize="11"
                                           Foreground="#4CAF50" />
                                <TextBlock Text="♥"
                                           IsVisible="{Binding IsFavorite}"
                                           FontSize="11"
                                           Foreground="#E57373" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</ContentPage>
