<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyMdb.app.ViewModels"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="820"
             Header="MyMDB"
             x:DataType="vm:HomeViewModel"
             x:Class="MyMdb.app.Views.HomeView">

    <Grid>
        <!-- First-time Google Drive connection screen -->
        <StackPanel IsVisible="{Binding NeedsGoogleDriveAuth}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Margin="24">
            <Border Width="96"
                    Height="96"
                    CornerRadius="20"
                    ClipToBounds="True"
                    HorizontalAlignment="Center">
                <Image Source="avares://MyMdb.app/Assets/Icon.png"
                       Stretch="UniformToFill" />
            </Border>
            <Button Content="Conectar Google Drive"
                    Command="{Binding ConnectGoogleDriveCommand}"
                    IsEnabled="{Binding !IsConnecting}"
                    HorizontalAlignment="Center"
                    Padding="24,10"
                    FontSize="15" />
            <ProgressBar IsVisible="{Binding IsConnecting}"
                         IsIndeterminate="{Binding IsConnecting}"
                         Width="160"
                         Height="4"
                         HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="320" />
        </StackPanel>

        <!-- Main catalog content -->
        <Grid IsVisible="{Binding !NeedsGoogleDriveAuth}"
              RowDefinitions="Auto,Auto,Auto,*"
              Margin="12,8,12,12"
              RowSpacing="8">
        <!-- Search bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText}"
                     PlaceholderText="Buscar título, director, actor..."
                     KeyDown="SearchBox_KeyDown"
                     ClearSelectionOnLostFocus="False" />
            <Button Grid.Column="1"
                    Content="Buscar"
                    Command="{Binding SearchCommand}" />
        </Grid>

        <!-- Quick filters -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Todas"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="All" />
                <Button Content="Películas"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Movies" />
                <Button Content="Series"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Series" />
                <Button Content="Vistas"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Watched" />
                <Button Content="Sin ver"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Unwatched" />
            </StackPanel>
        </ScrollViewer>

        <!-- Genre filter / Status / Sync / Sign out / Error -->
        <StackPanel Grid.Row="2" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding AvailableGenres}"
                          SelectedItem="{Binding SelectedGenre}"
                          MinWidth="145"
                          FontSize="12" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2"
                        Content="Sincronizar"
                        Command="{Binding SyncCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        FontSize="12"
                        Padding="10,4" />
                <Button Grid.Column="3"
                        Command="{Binding RequestSignOutCommand}"
                        IsVisible="{Binding SupportsSignOut}"
                        IsEnabled="{Binding !IsLoading}"
                        ToolTip.Tip="Cerrar sesión"
                        AutomationProperties.Name="Cerrar sesión"
                        Padding="8,5">
                    <PathIcon Width="16"
                              Height="16"
                              Data="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z" />
                </Button>
            </Grid>
            <TextBlock Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Paginated catalog list + Load More footer -->
        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="10">
                <ListBox Name="CatalogList"
                         ItemsSource="{Binding FilteredEntries}"
                         SelectionChanged="CatalogList_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MediaItemViewModel">
                            <Grid ColumnDefinitions="56,*" ColumnSpacing="12" Height="92" Margin="0,4">
                                <Border Grid.Column="0"
                                        Width="56"
                                        Height="84"
                                        CornerRadius="6"
                                        ClipToBounds="True"
                                        Background="#22808080">
                                    <Image Source="{Binding Poster}"
                                           Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding MetaLine}"
                                               FontSize="12"
                                               Opacity="0.75" />
                                    <TextBlock Text="{Binding GenresLine}"
                                               FontSize="12"
                                               Opacity="0.65"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding RatingText}"
                                                   IsVisible="{Binding HasRating}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E0A800" />
                                        <TextBlock Text="Serie"
                                                   IsVisible="{Binding IsTvSeries}"
                                                   FontSize="11"
                                                   Opacity="0.75" />
                                        <TextBlock Text="Vista"
                                                   IsVisible="{Binding IsWatched}"
                                                   FontSize="11"
                                                   Foreground="#4CAF50" />
                                        <TextBlock Text="♥"
                                                   IsVisible="{Binding IsFavorite}"
                                                   FontSize="11"
                                                   Foreground="#E57373" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Load more button / loading indicator -->
                <Grid HorizontalAlignment="Center" Margin="0,4,0,16">
                    <Button Content="Cargar más"
                            Command="{Binding LoadMoreCommand}"
                            IsVisible="{Binding ShowLoadMoreButton}"
                            Padding="20,8" />
                    <StackPanel IsVisible="{Binding IsLoadingMore}"
                                Spacing="6"
                                HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="{Binding IsLoadingMore}"
                                     Width="140"
                                     Height="4" />
                        <TextBlock Text="Cargando..."
                                   FontSize="12"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!-- Sign-out confirmation modal (works on both Desktop and Android) -->
        <Border IsVisible="{Binding IsSignOutConfirmOpen}"
                Background="#66000000">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Padding="20"
                    MaxWidth="320"
                    Margin="24"
                    Background="#F2242424">
                <StackPanel Spacing="14">
                    <TextBlock Text="¿Cerrar sesión?"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Se desconectará tu cuenta de Google Drive, pero tu caché local se mantendrá."
                               Foreground="#DDDDDD"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="Cancelar"
                                Command="{Binding CancelSignOutCommand}"
                                Foreground="White" />
                        <Button Content="Cerrar sesión"
                                Command="{Binding ConfirmSignOutCommand}"
                                Background="#C62828"
                                Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ContentPage>
